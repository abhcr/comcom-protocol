{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.1/schemas/discovery.schema.json",
  "title": "Comcom v0.2.1 RFC 9727 API catalog linkset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "linkset"
  ],
  "properties": {
    "linkset": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anchor",
          "item"
        ],
        "properties": {
          "anchor": {
            "type": "string",
            "format": "uri"
          },
          "item": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "href",
                "type",
                "profile"
              ],
              "properties": {
                "href": {
                  "type": "string",
                  "format": "uri"
                },
                "type": {
                  "const": "application/vnd.comcom.manifest+json"
                },
                "profile": {
                  "enum": [
                    "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/manifest",
                    "https://abhcr.github.io/comcom-protocol/releases/v0.2.1/profiles/manifest"
                  ]
                },
                "title": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    }
  }
}
