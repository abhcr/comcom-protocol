{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/capabilities/comcom-contract-terminate.input.schema.json",
  "title": "Contract Terminate input",
  "description": "Terminate contract using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.contract.terminate"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "description": "Contract URI.",
          "format": "uri-reference"
        },
        "reason": {
          "type": "string",
          "description": "Reason code or concise explanation."
        }
      }
    }
  }
}
