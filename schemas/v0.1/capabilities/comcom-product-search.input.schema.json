{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/capabilities/comcom-product-search.input.schema.json",
  "title": "Product Search input",
  "description": "Search for product using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.product.search"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria"
      ],
      "properties": {
        "criteria": {
          "type": "object",
          "description": "Typed product filters.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "array"
            ]
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "description": "Opaque continuation cursor."
        }
      }
    }
  }
}
