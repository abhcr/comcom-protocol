{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/capabilities/comcom-availability-check.input.schema.json",
  "title": "Availability Check input",
  "description": "Check availability using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.availability.check"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceId",
        "start",
        "end"
      ],
      "properties": {
        "serviceId": {
          "type": "string",
          "description": "Service or offering URI.",
          "format": "uri-reference"
        },
        "start": {
          "type": "string",
          "description": "Inclusive search start.",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "description": "Exclusive search end.",
          "format": "date-time"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Capacity required."
        }
      }
    }
  }
}
