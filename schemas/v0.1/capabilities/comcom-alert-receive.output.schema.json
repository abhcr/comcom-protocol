{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/capabilities/comcom-alert-receive.output.schema.json",
  "title": "Alert Receive output",
  "description": "Deterministic outcome for comcom.alert.receive.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disposition",
    "receivedAt"
  ],
  "properties": {
    "disposition": {
      "enum": [
        "accepted",
        "discarded",
        "duplicate"
      ]
    },
    "receivedAt": {
      "type": "string",
      "description": "Receipt time.",
      "format": "date-time"
    }
  }
}
