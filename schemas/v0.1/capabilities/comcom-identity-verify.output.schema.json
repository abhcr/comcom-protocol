{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/capabilities/comcom-identity-verify.output.schema.json",
  "title": "Identity Verify output",
  "description": "Deterministic outcome for comcom.identity.verify.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "resource"
  ],
  "properties": {
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "resource": {
      "$ref": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/resource.schema.json"
    },
    "nextActions": {
      "type": "array",
      "description": "Capability IDs permitted next.",
      "items": {
        "type": "string",
        "description": "Capability ID.",
        "pattern": "^(comcom|[a-z0-9-]+(\\.[a-z0-9-]+)+)\\.[a-z0-9.-]+$"
      },
      "uniqueItems": true
    }
  }
}
