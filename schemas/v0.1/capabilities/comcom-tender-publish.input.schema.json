{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/capabilities/comcom-tender-publish.input.schema.json",
  "title": "Tender Publish input",
  "description": "Publish tender using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.tender.publish"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "object",
          "description": "Structured Tender content.",
          "additionalProperties": true
        },
        "effectiveAt": {
          "type": "string",
          "description": "Effective time.",
          "format": "date-time"
        }
      }
    }
  }
}
