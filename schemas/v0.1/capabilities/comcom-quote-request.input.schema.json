{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/capabilities/comcom-quote-request.input.schema.json",
  "title": "Quote Request input",
  "description": "Request quote using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.quote.request"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "currency"
      ],
      "properties": {
        "items": {
          "type": "array",
          "description": "Items and requested quantities.",
          "items": {
            "type": "object",
            "description": "Quote line.",
            "additionalProperties": false,
            "required": [
              "itemId",
              "quantity"
            ],
            "properties": {
              "itemId": {
                "type": "string",
                "description": "Item URI.",
                "format": "uri-reference"
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "minItems": 1
        },
        "currency": {
          "type": "string",
          "description": "ISO 4217 currency code.",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  }
}
