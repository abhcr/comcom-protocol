{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/capabilities/comcom-payment-confirm.input.schema.json",
  "title": "Payment Confirm input",
  "description": "Confirm payment using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.payment.confirm"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "description": "Payment URI.",
          "format": "uri-reference"
        },
        "decisionAt": {
          "type": "string",
          "description": "Decision time.",
          "format": "date-time"
        }
      }
    }
  }
}
