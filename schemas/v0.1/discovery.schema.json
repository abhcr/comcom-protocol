{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abhcr.github.io/comcom-protocol/schemas/v0.1/discovery.schema.json",
  "title": "Comcom discovery document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versions",
    "manifest"
  ],
  "properties": {
    "versions": {
      "type": "array",
      "description": "Supported protocol versions.",
      "items": {
        "type": "string",
        "description": "Major.minor version.",
        "pattern": "^[0-9]+\\.[0-9]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "manifest": {
      "type": "string",
      "description": "Absolute capability manifest URL.",
      "format": "uri"
    }
  }
}
