{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/release-manifest.schema.json",
  "title": "Comcom immutable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["release", "protocolVersion", "maturity", "createdAt", "files", "treeSha256"],
  "properties": {
    "release": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "protocolVersion": { "const": "0.2" },
    "maturity": { "enum": ["experimental", "stable"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "mediaType": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 16777216 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "treeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
