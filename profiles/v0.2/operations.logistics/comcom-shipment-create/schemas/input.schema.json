{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/operations.logistics/comcom-shipment-create/schemas/input.schema.json",
  "title": "Shipment Create input",
  "description": "Create shipment using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.shipment.create"
    },
    "parameters": {
      "type": "object",
      "description": "Shipment Create parameters.",
      "additionalProperties": false,
      "required": [
        "shipment"
      ],
      "properties": {
        "shipment": {
          "type": "object",
          "description": "Typed Shipment data.",
          "additionalProperties": false,
          "required": [
            "shipmentId",
            "carrierId",
            "trackingCode"
          ],
          "properties": {
            "statusCode": {
              "type": "string",
              "description": "Profile-defined business state.",
              "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
            },
            "shipmentId": {
              "type": "string",
              "description": "Shipment URI.",
              "format": "uri-reference"
            },
            "carrierId": {
              "type": "string",
              "description": "Carrier URI.",
              "format": "uri-reference"
            },
            "trackingCode": {
              "type": "string",
              "description": "Carrier tracking code.",
              "maxLength": 100
            },
            "originLocationId": {
              "type": "string",
              "description": "Origin location URI.",
              "format": "uri-reference"
            },
            "destinationLocationId": {
              "type": "string",
              "description": "Destination location URI.",
              "format": "uri-reference"
            },
            "estimatedAt": {
              "type": "string",
              "description": "Estimated event instant.",
              "format": "date-time"
            },
            "occurredAt": {
              "type": "string",
              "description": "Actual event instant.",
              "format": "date-time"
            },
            "packageCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        "requestedAt": {
          "type": "string",
          "description": "Requested effective instant.",
          "format": "date-time"
        }
      }
    }
  }
}
