{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/operations.logistics/comcom-proof-of-delivery-get/schemas/input.schema.json",
  "title": "Proof Of Delivery Get input",
  "description": "Retrieve proof of delivery using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.proof.of.delivery.get"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the ProofOfDelivery to inspect.",
      "additionalProperties": false,
      "required": [
        "proofOfDeliveryId"
      ],
      "properties": {
        "proofOfDeliveryId": {
          "type": "string",
          "description": "ProofOfDelivery URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
