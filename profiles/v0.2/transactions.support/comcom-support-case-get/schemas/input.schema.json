{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/transactions.support/comcom-support-case-get/schemas/input.schema.json",
  "title": "Support Case Get input",
  "description": "Retrieve support case using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.support.case.get"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the SupportCase to inspect.",
      "additionalProperties": false,
      "required": [
        "supportCaseId"
      ],
      "properties": {
        "supportCaseId": {
          "type": "string",
          "description": "SupportCase URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
