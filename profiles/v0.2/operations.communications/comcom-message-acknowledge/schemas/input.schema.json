{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/operations.communications/comcom-message-acknowledge/schemas/input.schema.json",
  "title": "Message Acknowledge input",
  "description": "Acknowledge message using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.message.acknowledge"
    },
    "parameters": {
      "type": "object",
      "description": "Message Acknowledge parameters.",
      "additionalProperties": false,
      "required": [
        "messageId"
      ],
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Message URI.",
          "format": "uri-reference"
        },
        "reasonCode": {
          "type": "string",
          "description": "Profile-defined reason code.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "effectiveAt": {
          "type": "string",
          "description": "Requested effective instant.",
          "format": "date-time"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
