{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/identity.relationships/comcom-directory-search/schemas/input.schema.json",
  "title": "Directory Search input",
  "description": "Search for directory using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.directory.search"
    },
    "parameters": {
      "type": "object",
      "description": "Typed Directory discovery parameters.",
      "additionalProperties": false,
      "required": [
        "filters"
      ],
      "properties": {
        "query": {
          "type": "string",
          "description": "Human-supplied literal search text; no fuzzy capability matching is implied.",
          "maxLength": 500
        },
        "filters": {
          "type": "object",
          "description": "Typed Directory filters.",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "statusCode": {
              "type": "string",
              "description": "Profile-defined business state.",
              "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
            },
            "subjectId": {
              "type": "string",
              "description": "Subject URI.",
              "format": "uri-reference"
            },
            "issuerId": {
              "type": "string",
              "description": "Issuing or controlling entity URI.",
              "format": "uri-reference"
            },
            "referenceNumber": {
              "type": "string",
              "description": "Authority or document reference.",
              "maxLength": 160
            },
            "purposeCode": {
              "type": "string",
              "description": "Declared purpose code.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "claimCodes": {
              "type": "array",
              "description": "Declared claim codes.",
              "items": {
                "type": "string",
                "description": "Claim code.",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "uniqueItems": true,
              "maxItems": 100
            },
            "validFrom": {
              "type": "string",
              "description": "Validity start.",
              "format": "date-time"
            },
            "validUntil": {
              "type": "string",
              "description": "Validity end.",
              "format": "date-time"
            }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "description": "Opaque continuation cursor.",
          "maxLength": 500
        }
      }
    }
  }
}
