{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/regulated.public/comcom-government-application-status/schemas/input.schema.json",
  "title": "Government Application Status input",
  "description": "Retrieve status for government application using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.government.application.status"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the GovernmentApplication to inspect.",
      "additionalProperties": false,
      "required": [
        "governmentApplicationId"
      ],
      "properties": {
        "governmentApplicationId": {
          "type": "string",
          "description": "GovernmentApplication URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
