{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/operations.digital/comcom-sensor-reading-get/schemas/input.schema.json",
  "title": "Sensor Reading Get input",
  "description": "Retrieve sensor reading using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.sensor.reading.get"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the SensorReading to inspect.",
      "additionalProperties": false,
      "required": [
        "sensorReadingId"
      ],
      "properties": {
        "sensorReadingId": {
          "type": "string",
          "description": "SensorReading URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
