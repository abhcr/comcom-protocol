{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/regulated.finance/comcom-payment-status-get/schemas/input.schema.json",
  "title": "Payment Status Get input",
  "description": "Retrieve payment status using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.payment.status.get"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the PaymentStatus to inspect.",
      "additionalProperties": false,
      "required": [
        "paymentStatusId"
      ],
      "properties": {
        "paymentStatusId": {
          "type": "string",
          "description": "PaymentStatus URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
