{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/regulated.social/comcom-healthcare-provider-search/schemas/input.schema.json",
  "title": "Healthcare Provider Search input",
  "description": "Search for healthcare provider using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.healthcare.provider.search"
    },
    "parameters": {
      "type": "object",
      "description": "Typed HealthcareProvider discovery parameters.",
      "additionalProperties": false,
      "required": [
        "filters"
      ],
      "properties": {
        "query": {
          "type": "string",
          "description": "Human-supplied literal search text; no fuzzy capability matching is implied.",
          "maxLength": 500
        },
        "filters": {
          "type": "object",
          "description": "Typed HealthcareProvider filters.",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "statusCode": {
              "type": "string",
              "description": "Profile-defined business state.",
              "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
            },
            "patientId": {
              "type": "string",
              "description": "Patient URI.",
              "format": "uri-reference"
            },
            "providerId": {
              "type": "string",
              "description": "Healthcare provider URI.",
              "format": "uri-reference"
            },
            "serviceCode": {
              "type": "string",
              "description": "Clinical service code.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "referralId": {
              "type": "string",
              "description": "Referral URI.",
              "format": "uri-reference"
            },
            "prescriptionId": {
              "type": "string",
              "description": "Prescription URI.",
              "format": "uri-reference"
            },
            "scheduledAt": {
              "type": "string",
              "description": "Scheduled instant.",
              "format": "date-time"
            },
            "purposeCode": {
              "type": "string",
              "description": "Authorized purpose code.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "cursor": {
          "type": "string",
          "description": "Opaque continuation cursor.",
          "maxLength": 500
        }
      }
    }
  }
}
