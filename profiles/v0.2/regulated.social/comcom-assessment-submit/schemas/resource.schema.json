{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/regulated.social/comcom-assessment-submit/schemas/resource.schema.json",
  "title": "Assessment resource for comcom.assessment.submit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "state",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique resource URI.",
      "format": "uri-reference"
    },
    "type": {
      "const": "Assessment"
    },
    "state": {
      "enum": [
        "submitted",
        "accepted",
        "rejected"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "description": "Creation instant.",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "description": "Last update instant.",
      "format": "date-time"
    },
    "statusCode": {
      "type": "string",
      "description": "Profile-defined business state.",
      "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
    },
    "learnerId": {
      "type": "string",
      "description": "Learner URI.",
      "format": "uri-reference"
    },
    "providerId": {
      "type": "string",
      "description": "Education or research provider URI.",
      "format": "uri-reference"
    },
    "courseId": {
      "type": "string",
      "description": "Course URI.",
      "format": "uri-reference"
    },
    "assessmentCode": {
      "type": "string",
      "description": "Assessment or progress code.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "score": {
      "type": "string",
      "description": "Score or measured progress.",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "completedAt": {
      "type": "string",
      "description": "Completion instant.",
      "format": "date-time"
    },
    "purposeCode": {
      "type": "string",
      "description": "Research or education purpose code.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
