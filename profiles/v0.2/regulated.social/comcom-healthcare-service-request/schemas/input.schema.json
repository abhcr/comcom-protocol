{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/regulated.social/comcom-healthcare-service-request/schemas/input.schema.json",
  "title": "Healthcare Service Request input",
  "description": "Request healthcare service using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.healthcare.service.request"
    },
    "parameters": {
      "type": "object",
      "description": "Healthcare Service Request parameters.",
      "additionalProperties": false,
      "required": [
        "healthcareService"
      ],
      "properties": {
        "healthcareService": {
          "type": "object",
          "description": "Typed HealthcareService data.",
          "additionalProperties": false,
          "required": [
            "patientId",
            "providerId",
            "serviceCode"
          ],
          "properties": {
            "statusCode": {
              "type": "string",
              "description": "Profile-defined business state.",
              "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
            },
            "patientId": {
              "type": "string",
              "description": "Patient URI.",
              "format": "uri-reference"
            },
            "providerId": {
              "type": "string",
              "description": "Healthcare provider URI.",
              "format": "uri-reference"
            },
            "serviceCode": {
              "type": "string",
              "description": "Clinical service code.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "referralId": {
              "type": "string",
              "description": "Referral URI.",
              "format": "uri-reference"
            },
            "prescriptionId": {
              "type": "string",
              "description": "Prescription URI.",
              "format": "uri-reference"
            },
            "scheduledAt": {
              "type": "string",
              "description": "Scheduled instant.",
              "format": "date-time"
            },
            "purposeCode": {
              "type": "string",
              "description": "Authorized purpose code.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        },
        "requestedAt": {
          "type": "string",
          "description": "Requested effective instant.",
          "format": "date-time"
        }
      }
    }
  }
}
