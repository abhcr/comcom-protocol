{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/regulated.social/comcom-education-progress-get/schemas/input.schema.json",
  "title": "Education Progress Get input",
  "description": "Retrieve education progress using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.education.progress.get"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the EducationProgress to inspect.",
      "additionalProperties": false,
      "required": [
        "educationProgressId"
      ],
      "properties": {
        "educationProgressId": {
          "type": "string",
          "description": "EducationProgress URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
