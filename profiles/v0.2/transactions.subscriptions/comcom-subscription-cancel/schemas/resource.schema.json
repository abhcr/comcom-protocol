{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/transactions.subscriptions/comcom-subscription-cancel/schemas/resource.schema.json",
  "title": "Subscription resource for comcom.subscription.cancel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "state",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique resource URI.",
      "format": "uri-reference"
    },
    "type": {
      "const": "Subscription"
    },
    "state": {
      "enum": [
        "accepted",
        "active",
        "cancelled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "description": "Creation instant.",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "description": "Last update instant.",
      "format": "date-time"
    },
    "statusCode": {
      "type": "string",
      "description": "Profile-defined business state.",
      "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
    },
    "subscriberId": {
      "type": "string",
      "description": "Subscriber URI.",
      "format": "uri-reference"
    },
    "planId": {
      "type": "string",
      "description": "Plan URI.",
      "format": "uri-reference"
    },
    "start": {
      "type": "string",
      "description": "Service start.",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "description": "Service end.",
      "format": "date-time"
    },
    "quantity": {
      "type": "string",
      "description": "Subscribed quantity.",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "unitCode": {
      "type": "string",
      "description": "Subscription unit code.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
