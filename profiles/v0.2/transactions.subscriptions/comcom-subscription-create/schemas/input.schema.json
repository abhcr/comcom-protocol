{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/transactions.subscriptions/comcom-subscription-create/schemas/input.schema.json",
  "title": "Subscription Create input",
  "description": "Create subscription using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.subscription.create"
    },
    "parameters": {
      "type": "object",
      "description": "Subscription Create parameters.",
      "additionalProperties": false,
      "required": [
        "subscription"
      ],
      "properties": {
        "subscription": {
          "type": "object",
          "description": "Typed Subscription data.",
          "additionalProperties": false,
          "required": [
            "subscriberId",
            "planId",
            "start"
          ],
          "properties": {
            "statusCode": {
              "type": "string",
              "description": "Profile-defined business state.",
              "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
            },
            "subscriberId": {
              "type": "string",
              "description": "Subscriber URI.",
              "format": "uri-reference"
            },
            "planId": {
              "type": "string",
              "description": "Plan URI.",
              "format": "uri-reference"
            },
            "start": {
              "type": "string",
              "description": "Service start.",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "description": "Service end.",
              "format": "date-time"
            },
            "quantity": {
              "type": "string",
              "description": "Subscribed quantity.",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "unitCode": {
              "type": "string",
              "description": "Subscription unit code.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        },
        "requestedAt": {
          "type": "string",
          "description": "Requested effective instant.",
          "format": "date-time"
        }
      }
    }
  }
}
