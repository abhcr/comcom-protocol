{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/transactions.scheduling/comcom-availability-check/schemas/input.schema.json",
  "title": "Availability Check input",
  "description": "Check availability using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.availability.check"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the Availability to inspect.",
      "additionalProperties": false,
      "required": [
        "availabilityId"
      ],
      "properties": {
        "availabilityId": {
          "type": "string",
          "description": "Availability URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
