{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/transactions.scheduling/comcom-appointment-checkin/schemas/input.schema.json",
  "title": "Appointment Checkin input",
  "description": "Check in to appointment using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.appointment.checkin"
    },
    "parameters": {
      "type": "object",
      "description": "Appointment Checkin parameters.",
      "additionalProperties": false,
      "required": [
        "appointmentId"
      ],
      "properties": {
        "appointmentId": {
          "type": "string",
          "description": "Appointment URI.",
          "format": "uri-reference"
        },
        "reasonCode": {
          "type": "string",
          "description": "Profile-defined reason code.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "effectiveAt": {
          "type": "string",
          "description": "Requested effective instant.",
          "format": "date-time"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
