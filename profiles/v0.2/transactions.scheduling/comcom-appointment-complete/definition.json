{
  "id": "comcom.appointment.complete",
  "version": "0.2.0",
  "status": "draft",
  "profile": "transactions.scheduling",
  "batch": 3,
  "title": "Appointment Complete",
  "purpose": "Complete appointment using the typed Comcom v0.2 profile.",
  "requestKind": "command",
  "resourceType": "Appointment",
  "actors": {
    "initiator": "requester",
    "responder": "provider"
  },
  "directions": [
    "send",
    "receive"
  ],
  "minimumSecurity": "authenticated",
  "executionModes": [
    "synchronous",
    "asynchronous"
  ],
  "schemas": {
    "input": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/transactions.scheduling/comcom-appointment-complete/schemas/input.schema.json",
    "output": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/transactions.scheduling/comcom-appointment-complete/schemas/output.schema.json",
    "resource": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/transactions.scheduling/comcom-appointment-complete/schemas/resource.schema.json"
  },
  "preconditions": [
    "authenticated-sender",
    "authorized-principal",
    "valid-resource-state"
  ],
  "lifecycle": {
    "states": [
      "accepted",
      "active",
      "inProgress",
      "completed"
    ],
    "transitions": [
      {
        "from": "accepted",
        "to": "completed"
      },
      {
        "from": "active",
        "to": "completed"
      },
      {
        "from": "inProgress",
        "to": "completed"
      }
    ]
  },
  "retry": {
    "safe": true,
    "idempotencyRequired": true,
    "equality": "RFC8785-semantic-projection"
  },
  "reversal": {
    "mode": "explicitCapability",
    "capability": "comcom.appointment.cancel"
  },
  "errors": [
    "schema-invalid",
    "authorization-insufficient",
    "invalid-state-transition",
    "idempotency-conflict"
  ],
  "standards": [
    "https://www.rfc-editor.org/rfc/rfc5545",
    "https://schema.org/ReserveAction"
  ]
}
