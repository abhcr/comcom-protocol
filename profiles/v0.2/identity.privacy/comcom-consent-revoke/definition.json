{
  "id": "comcom.consent.revoke",
  "version": "0.2.0",
  "status": "draft",
  "profile": "identity.privacy",
  "batch": 5,
  "title": "Consent Revoke",
  "purpose": "Revoke consent using the typed Comcom v0.2 profile.",
  "requestKind": "command",
  "resourceType": "Consent",
  "actors": {
    "initiator": "requester",
    "responder": "provider"
  },
  "directions": [
    "send",
    "receive"
  ],
  "minimumSecurity": "authenticated",
  "executionModes": [
    "synchronous",
    "asynchronous"
  ],
  "schemas": {
    "input": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/identity.privacy/comcom-consent-revoke/schemas/input.schema.json",
    "output": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/identity.privacy/comcom-consent-revoke/schemas/output.schema.json",
    "resource": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/identity.privacy/comcom-consent-revoke/schemas/resource.schema.json"
  },
  "preconditions": [
    "authenticated-sender",
    "authorized-principal",
    "valid-resource-state"
  ],
  "lifecycle": {
    "states": [
      "active",
      "revoked"
    ],
    "transitions": [
      {
        "from": "active",
        "to": "revoked"
      }
    ]
  },
  "retry": {
    "safe": true,
    "idempotencyRequired": true,
    "equality": "RFC8785-semantic-projection"
  },
  "reversal": {
    "mode": "compensationRequired"
  },
  "errors": [
    "schema-invalid",
    "authorization-insufficient",
    "invalid-state-transition",
    "idempotency-conflict"
  ],
  "standards": [
    "https://www.w3.org/TR/vc-data-model-2.0/"
  ]
}
