{
  "id": "comcom.order.change",
  "version": "0.2.0",
  "status": "draft",
  "profile": "commerce.orders",
  "batch": 2,
  "title": "Order Change",
  "purpose": "Change order using the typed Comcom v0.2 profile.",
  "requestKind": "command",
  "resourceType": "Order",
  "actors": {
    "initiator": "requester",
    "responder": "provider"
  },
  "directions": [
    "send",
    "receive"
  ],
  "minimumSecurity": "authenticated",
  "executionModes": [
    "synchronous",
    "asynchronous"
  ],
  "schemas": {
    "input": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/commerce.orders/comcom-order-change/schemas/input.schema.json",
    "output": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/commerce.orders/comcom-order-change/schemas/output.schema.json",
    "resource": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/commerce.orders/comcom-order-change/schemas/resource.schema.json"
  },
  "preconditions": [
    "authenticated-sender",
    "authorized-principal",
    "valid-resource-state"
  ],
  "lifecycle": {
    "states": [
      "active"
    ],
    "transitions": [
      {
        "from": "active",
        "to": "active",
        "revisionRequired": true
      }
    ]
  },
  "retry": {
    "safe": true,
    "idempotencyRequired": true,
    "equality": "RFC8785-semantic-projection"
  },
  "reversal": {
    "mode": "explicitCapability",
    "capability": "comcom.order.cancel"
  },
  "errors": [
    "schema-invalid",
    "authorization-insufficient",
    "invalid-state-transition",
    "idempotency-conflict"
  ],
  "standards": [
    "https://docs.oasis-open.org/ubl/UBL-2.4.html"
  ]
}
