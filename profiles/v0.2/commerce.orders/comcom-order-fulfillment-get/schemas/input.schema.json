{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/commerce.orders/comcom-order-fulfillment-get/schemas/input.schema.json",
  "title": "Order Fulfillment Get input",
  "description": "Retrieve order fulfillment using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.order.fulfillment.get"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the OrderFulfillment to inspect.",
      "additionalProperties": false,
      "required": [
        "orderFulfillmentId"
      ],
      "properties": {
        "orderFulfillmentId": {
          "type": "string",
          "description": "OrderFulfillment URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
