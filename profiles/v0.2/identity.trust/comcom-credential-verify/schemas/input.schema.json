{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/identity.trust/comcom-credential-verify/schemas/input.schema.json",
  "title": "Credential Verify input",
  "description": "Verify credential using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.credential.verify"
    },
    "parameters": {
      "type": "object",
      "description": "Identify the Credential to inspect.",
      "additionalProperties": false,
      "required": [
        "credentialId"
      ],
      "properties": {
        "credentialId": {
          "type": "string",
          "description": "Credential URI.",
          "format": "uri-reference"
        },
        "at": {
          "type": "string",
          "description": "Evaluation instant.",
          "format": "date-time"
        }
      }
    }
  }
}
