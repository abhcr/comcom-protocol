{
  "id": "comcom.certificate.issue",
  "version": "0.2.0",
  "status": "draft",
  "profile": "identity.trust",
  "batch": 5,
  "title": "Certificate Issue",
  "purpose": "Issue certificate using the typed Comcom v0.2 profile.",
  "requestKind": "command",
  "resourceType": "Certificate",
  "actors": {
    "initiator": "requester",
    "responder": "provider"
  },
  "directions": [
    "send",
    "receive"
  ],
  "minimumSecurity": "authenticated",
  "executionModes": [
    "synchronous",
    "asynchronous"
  ],
  "schemas": {
    "input": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/identity.trust/comcom-certificate-issue/schemas/input.schema.json",
    "output": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/identity.trust/comcom-certificate-issue/schemas/output.schema.json",
    "resource": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/identity.trust/comcom-certificate-issue/schemas/resource.schema.json"
  },
  "preconditions": [
    "authenticated-sender",
    "authorized-principal",
    "valid-resource-state"
  ],
  "lifecycle": {
    "states": [
      "proposed",
      "accepted",
      "rejected",
      "active",
      "completed",
      "cancelled"
    ],
    "transitions": [
      {
        "from": "none",
        "to": "proposed"
      },
      {
        "from": "proposed",
        "to": "accepted"
      },
      {
        "from": "proposed",
        "to": "rejected"
      }
    ]
  },
  "retry": {
    "safe": true,
    "idempotencyRequired": true,
    "equality": "RFC8785-semantic-projection"
  },
  "reversal": {
    "mode": "compensationRequired"
  },
  "errors": [
    "schema-invalid",
    "authorization-insufficient",
    "invalid-state-transition",
    "idempotency-conflict"
  ],
  "standards": [
    "https://www.w3.org/TR/vc-data-model-2.0/"
  ]
}
