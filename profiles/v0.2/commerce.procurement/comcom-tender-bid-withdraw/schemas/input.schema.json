{
  "$schema": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/schemas/comcom-meta.schema.json",
  "$id": "https://abhcr.github.io/comcom-protocol/releases/v0.2.0/profiles/v0.2/commerce.procurement/comcom-tender-bid-withdraw/schemas/input.schema.json",
  "title": "Tender Bid Withdraw input",
  "description": "Withdraw tender bid using an exact, schema-validated Comcom interaction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "parameters"
  ],
  "properties": {
    "capability": {
      "const": "comcom.tender.bid.withdraw"
    },
    "parameters": {
      "type": "object",
      "description": "Tender Bid Withdraw parameters.",
      "additionalProperties": false,
      "required": [
        "tenderBidId"
      ],
      "properties": {
        "tenderBidId": {
          "type": "string",
          "description": "TenderBid URI.",
          "format": "uri-reference"
        },
        "reasonCode": {
          "type": "string",
          "description": "Profile-defined reason code.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "effectiveAt": {
          "type": "string",
          "description": "Requested effective instant.",
          "format": "date-time"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
